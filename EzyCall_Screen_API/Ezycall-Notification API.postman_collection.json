      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "let jsonData = pm.response.json();",
              "if (jsonData.otp) { pm.collectionVariables.set('otp', jsonData.otp); }",
              "pm.test('Login OTP request successful', function () {",
              "    pm.expect(jsonData.success).to.eql(true);",
